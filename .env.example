# Client and coordinator network settings
# API_URL overrides the URL derived from API_HOST and API_PORT.
API_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
# Optional host-port overrides used by Docker Compose.
COORDINATOR_PORT=8000
REDIS_PORT=6379

# Redis is used as both the Celery broker and result backend.
REDIS_URL=redis://127.0.0.1:6379/0

# Dedicated Celery queues
ALPHABET_QUEUE=alphabet_queue
PHRASE_QUEUE=phrase_queue

# Base timeout used by client/coordinator task requests.
TASK_TIMEOUT_SECONDS=10
TASK_STATUS_EXPIRATION_SECONDS=3600
API_MAX_REQUEST_BYTES=262144

# Worker registry heartbeat and failure detection.
WORKER_HEARTBEAT_SECONDS=5
WORKER_OFFLINE_SECONDS=15
